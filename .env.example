# Copy this file to .env and fill in real values. .env is gitignored and
# should never be committed (it will contain your actual server address and
# any real credentials/tokens once auth token caching is added).

# Server to connect to.
MINEBOT_HOST=127.0.0.1
MINEBOT_PORT=25565

# Username to log in with. Ignored in online mode (MINEBOT_ONLINE_MODE=true)
# -- your real Minecraft username/UUID comes from whichever Microsoft
# account you sign into via the device-code flow at startup instead.
MINEBOT_USERNAME=minebot

# "true" for a real Minecraft server requiring Microsoft account auth
# (triggers the device-code sign-in flow at startup); "false" for an
# offline-mode/cracked server, where MINEBOT_USERNAME above is used directly.
MINEBOT_ONLINE_MODE=false

# Optional: DEBUG/INFO/WARNING/ERROR. DEBUG turns on extra per-packet
# logging (e.g. entity-tracking packets in bot/play_loop.py) useful when
# troubleshooting something like "!follow does nothing". Defaults to INFO.
# MINEBOT_LOG_LEVEL=DEBUG
