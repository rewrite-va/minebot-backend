# Copy this file to .env and fill in real values. .env is gitignored and
# should never be committed.

# Where minebot-mod's local WebSocket control channel is listening (see
# that companion repo -- run a real Minecraft client with the mod
# installed, logged into the bot's account, before starting this).
# Defaults match the mod's own ControlServer.DEFAULT_PORT.
MINEBOT_MOD_HOST=127.0.0.1
MINEBOT_MOD_PORT=47893

# Optional: DEBUG/INFO/WARNING/ERROR. Defaults to INFO.
# MINEBOT_LOG_LEVEL=DEBUG
