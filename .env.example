# Copy this file to .env and fill in real values. .env is gitignored and
# should never be committed.

# Address/port this process binds its control-channel WebSocket server to.
# Python is the server; minebot-mod (a separate repo -- run a real
# Minecraft client with it installed, logged into the bot's account,
# before starting this) connects out to it as a client. Port defaults
# match the mod's own ControlClient.DEFAULT_PORT.
MINEBOT_MOD_HOST=0.0.0.0
MINEBOT_MOD_PORT=47893

# Address/port for the wire-message observer WebSocket -- a separate,
# read-only feed of every message sent to/received from the mod, for a
# live viewer (e.g. the minebot-frontend repo) to watch. Unlike the
# control channel above, any number of observer clients can connect at
# once; nobody connecting at all is the common case and costs nothing.
MINEBOT_OBSERVER_HOST=0.0.0.0
MINEBOT_OBSERVER_PORT=47894

# The bot's own in-game username -- used to decide whether a chat message
# is addressed to the bot (see minebot/llm/trigger.py). Should match
# whatever account minebot-mod is logged into.
MINEBOT_BOT_NAME=minebot

# Optional: comma-separated extra words/phrases that also trigger an LLM
# call, beyond the bot's own name -- e.g. a nickname, or a catch-all like
# "hey bot". Matched case-insensitively as a substring, same as the name.
# MINEBOT_TRIGGER_WORDS=bot,buddy,hey minebot

# Optional: DEBUG/INFO/WARNING/ERROR. Defaults to INFO.
# MINEBOT_LOG_LEVEL=DEBUG

# Optional: local path to the minebot-mod repo checkout, used only to
# warn if a connected mod's reported build (git commit) doesn't match
# this checkout's current HEAD -- catches a stale/undeployed client jar.
# Defaults to the path this project has used so far; point it elsewhere
# (or an invalid path) if that's not where minebot-mod lives on this
# machine -- the check just logs a warning and does nothing further if
# it can't read a commit from the given path.
# MINEBOT_MOD_REPO_PATH=/home/colaila/git/mods/minebot-mod
